{
	"name": "Import_Lore_To_Cosmos",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "CosmosDbSqlApiSink",
						"writeBehavior": "insert"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "MIRAVERSEOSX — World Lore Database",
									"type": "Int16"
								},
								"sink": {
									"path": "$['id']"
								}
							},
							{
								"source": {
									"name": "title",
									"type": "String"
								},
								"sink": {
									"path": "$['title']"
								}
							},
							{
								"source": {
									"name": "category",
									"type": "String"
								},
								"sink": {
									"path": "$['category']"
								}
							},
							{
								"source": {
									"name": "content_text",
									"type": "String"
								},
								"sink": {
									"path": "$['content_text']"
								}
							},
							{
								"source": {
									"name": "metadata_json",
									"type": "String"
								},
								"sink": {
									"path": "$['metadata_json']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DataExcel",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "miraversecosmosdb",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}