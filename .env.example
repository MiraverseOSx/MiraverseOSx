# MIRAVERSEOSX Environment Configuration Example
PORT=3000
NODE_ENV=development

# AI Logic Engine — Cloud Providers (Optional, auto-falls back to deterministic lore offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PREFERRED_PROVIDER=gemini
AI_DAILY_BUDGET_USD=1.00

# AI Subsystem — Groq API Configuration (Free Tier, 400ms speed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Blockchair Blockchain Stats API
BLOCKCHAIR_API_KEY=

# Agent Orchestrator (mcp-agents-groq) Configuration
MCP_SERVER_PORT=5050
MCP_AGENTS_GROQ_ENABLED=true
