# MIRAVERSEOSX Environment Configuration Example
PORT=3000
NODE_ENV=development

# AI Logic Engine — Groq API Configuration
GROQ_API_KEY=miragroq
GROQ_MODEL=llama-3.3-70b-versatile

# Local Cloud Configuration — LocalStack (Desktop / Docker)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Agent Orchestrator (mcp-agents-groq) Configuration
MCP_SERVER_PORT=5050
MCP_AGENTS_GROQ_ENABLED=true
