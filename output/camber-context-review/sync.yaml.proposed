# PROPOSAL ONLY. Do not push until authenticated pull, remote backup and approval.
agent: "ff089884-2462-4fab-9430-1859e784a313"
owner: "mirxclej"
alias: "mai"
exclude:
  - "**/.git/**"
  - "**/.env*"
  - "**/node_modules/**"
  - "**/__pycache__/**"
  - "**/.venv/**"
  - "**/bin/**"
  - "**/obj/**"
  - "**/dist/**"
  - "**/wwwroot/**"
  - "**/*.db"
  - "**/*.sqlite*"
  - "**/*.pem"
  - "**/*.key"
  - "**/saves/**"
instruction: {enabled: false}
readme: {enabled: false}
project: {enabled: true, path: project}
knowledge_base: {enabled: false}
chat: {enabled: false}
requirements: {enabled: false}
schema: {enabled: false}
skills:
  enabled: true
  path: .claude/skills
  managed: [validate-npcs, validate-missions, audit-rewards]
