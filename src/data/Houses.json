[{"House_ID":"HSE001","House_Name":"Halvorn","Motto":"Iron Will, Iron Rule","Region_ID":"REG001","Founding_Era":"Pre-Collapse","Allegiance":"Empire","Primary_Resource":"Steel & Weaponry","Seat_of_Power":"Ironspire Citadel","Rival_House_ID":"HSE010","Allied_House_ID":"HSE007","Member_Count_Approx":12000,"Prestige_Level":9,"Special_Ability":"Siege Mastery","Lore_Notes":"Founded by General Aldus Halvorn after the First Collapse. Built the Ironspire from rubble. Absolute military hierarchy."},{"House_ID":"HSE002","House_Name":"Solenne","Motto":"Truth Above All","Region_ID":"REG003","Founding_Era":"Ancient","Allegiance":"Republic","Primary_Resource":"Ancient Texts & Knowledge","Seat_of_Power":"Verdant Archive","Rival_House_ID":"HSE003","Allied_House_ID":"HSE005","Member_Count_Approx":3200,"Prestige_Level":7,"Special_Ability":"Ancient Knowledge","Lore_Notes":"Oldest academic house. Curators of pre-Collapse history. Believe the truth of the Miraverse's origin will one day be revealed."},{"House_ID":"HSE003","House_Name":"Nox","Motto":"In Darkness, Power","Region_ID":"REG002","Founding_Era":"Post-Collapse","Allegiance":"Shadow","Primary_Resource":"Political Influence","Seat_of_Power":"Nox Tower, Citadel","Rival_House_ID":"HSE001","Allied_House_ID":null,"Member_Count_Approx":1800,"Prestige_Level":8,"Special_Ability":"Shadow Influence","Lore_Notes":"Emerged from the chaos of the Post-Collapse era. Controls Citadel politics from the shadows. Publicly supports the Republic."},{"House_ID":"HSE004","House_Name":"Taum","Motto":"The Roots Remember","Region_ID":"REG005","Founding_Era":"Ancient","Allegiance":"Independent","Primary_Resource":"Botanical & Spiritual","Seat_of_Power":"The Great Root, Rootveil","Rival_House_ID":"HSE001","Allied_House_ID":"HSE002","Member_Count_Approx":5000,"Prestige_Level":6,"Special_Ability":"Nature Bond","Lore_Notes":"Pre-dates written history. Guardians of the Rootveil. Believe the ancient forest holds the memory of the original world."},{"House_ID":"HSE005","House_Name":"Voss","Motto":"Progress Without Limits","Region_ID":"REG002","Founding_Era":"Modern","Allegiance":"Republic","Primary_Resource":"Biotech & Patents","Seat_of_Power":"Voss Institute, Citadel","Rival_House_ID":"HSE004","Allied_House_ID":"HSE002","Member_Count_Approx":2400,"Prestige_Level":7,"Special_Ability":"Tech Augmentation","Lore_Notes":"Founded by the controversial scientist Orlan Voss. Pushes biological and digital augmentation beyond ethical limits."},{"House_ID":"HSE006","House_Name":"Dawnrider","Motto":"Speed is Survival","Region_ID":"REG006","Founding_Era":"Pre-Collapse","Allegiance":"Independent","Primary_Resource":"Desert Trade Routes","Seat_of_Power":"Oasis Stronghold, Sandveil","Rival_House_ID":"HSE001","Allied_House_ID":"HSE007","Member_Count_Approx":6500,"Prestige_Level":5,"Special_Ability":"Desert Navigation","Lore_Notes":"Nomadic clan that has survived every empire by moving faster than any army. Their maps are more valuable than gold."},{"House_ID":"HSE007","House_Name":"Crimsongate","Motto":"Gold Opens Every Door","Region_ID":"REG007","Founding_Era":"Post-Collapse","Allegiance":"Empire","Primary_Resource":"Trade Goods & Ships","Seat_of_Power":"Port Mira Harbor","Rival_House_ID":"HSE003","Allied_House_ID":"HSE006","Member_Count_Approx":9000,"Prestige_Level":6,"Special_Ability":"Trade Network","Lore_Notes":"Built Port Mira into the wealthiest city in the known world. Nominally Empire-aligned but sells to all sides."},{"House_ID":"HSE008","House_Name":"Obsidian","Motto":"None Escape the Dark","Region_ID":"REG004","Founding_Era":"Modern","Allegiance":"Shadow","Primary_Resource":"Black Market Goods","Seat_of_Power":"The Black Vault, Neon Sprawl","Rival_House_ID":"HSE001","Allied_House_ID":"HSE003","Member_Count_Approx":4200,"Prestige_Level":7,"Special_Ability":"Black Market Access","Lore_Notes":"Criminal dynasty disguised as a merchant house. Runs the Obsidian Syndicate. Publicly denies all criminal ties."},{"House_ID":"HSE009","House_Name":"Veilborn","Motto":"Beyond the Veil Lies Truth","Region_ID":"REG008","Founding_Era":"Unknown","Allegiance":"Independent","Primary_Resource":"Void Crystals","Seat_of_Power":"The Veil Sanctum, Void Rift","Rival_House_ID":"HSE001","Allied_House_ID":null,"Member_Count_Approx":800,"Prestige_Level":8,"Special_Ability":"Dimensional Sight","Lore_Notes":"Claim to have existed before the Miraverse was created. Their origin is tied to the Void Rift Incident."},{"House_ID":"HSE010","House_Name":"Ironclaw","Motto":"Strength Through Suffering","Region_ID":"REG001","Founding_Era":"Pre-Collapse","Allegiance":"Empire","Primary_Resource":"Warriors & Military Service","Seat_of_Power":"Ironclaw Keep, Ironspire","Rival_House_ID":"HSE009","Allied_House_ID":"HSE001","Member_Count_Approx":7800,"Prestige_Level":6,"Special_Ability":"Combat Endurance","Lore_Notes":"Subservient to Halvorn but deeply proud. Produces the Empire's finest ground soldiers. Long-standing tension with House Halvorn over autonomy."},{"House_ID":"HSE011","House_Name":"Mireth","Motto":"We Were First","Region_ID":"REG010","Founding_Era":"Ancient","Allegiance":"DESTROYED","Primary_Resource":"Unknown","Seat_of_Power":"Ruins, Undervault","Rival_House_ID":null,"Allied_House_ID":null,"Member_Count_Approx":0,"Prestige_Level":10,"Special_Ability":"Echoes of the Past (passive lore unlock)","Lore_Notes":"The Lost House. Destroyed before the First Collapse by an unknown force. The Undervault holds their buried seat of power."},{"House_ID":"HSE012","House_Name":"Ashenveil","Motto":"From Ash We Rise","Region_ID":"REG009","Founding_Era":"Post-Collapse","Allegiance":"Independent","Primary_Resource":"Mineral Ores","Seat_of_Power":"Ashenveil Crater, Shattered Peaks","Rival_House_ID":"HSE001","Allied_House_ID":"HSE010","Member_Count_Approx":3300,"Prestige_Level":5,"Special_Ability":"Mountain Fortification","Lore_Notes":"Survivors of the Shattered Peaks War. Rebuilt their clan in the ruins of the battlefield. Fiercely anti-Empire."},{"House_ID":"HSE013","House_Name":"Prismwatch","Motto":"Light Reveals All","Region_ID":"REG007","Founding_Era":"Modern","Allegiance":"Republic","Primary_Resource":"Surveillance Technology","Seat_of_Power":"Prism Tower, Port Mira","Rival_House_ID":"HSE008","Allied_House_ID":"HSE005","Member_Count_Approx":1500,"Prestige_Level":5,"Special_Ability":"Signal Intelligence","Lore_Notes":"Founded by a former Syndicate spy. Now provides intelligence services to the Verdant Republic. Syndicate considers them traitors."},{"House_ID":"HSE014","House_Name":"Deepkeel","Motto":"The Depths Provide","Region_ID":"REG007","Founding_Era":"Pre-Collapse","Allegiance":"Empire","Primary_Resource":"Marine Resources & Salvage","Seat_of_Power":"The Drowned Quay, Port Mira","Rival_House_ID":"HSE009","Allied_House_ID":"HSE007","Member_Count_Approx":4100,"Prestige_Level":4,"Special_Ability":"Deep Salvage","Lore_Notes":"Ancient seafaring house. Controls the underwater salvage lanes beneath Port Mira. Claims ancient Mireth ruins lie beneath the harbor."},{"House_ID":"HSE015","House_Name":"Nullborn","Motto":"We Were Never Here","Region_ID":"REG004","Founding_Era":"Modern","Allegiance":"Shadow","Primary_Resource":"Data & Identities","Seat_of_Power":"Ghost Server, Neon Sprawl","Rival_House_ID":"HSE005","Allied_House_ID":"HSE008","Member_Count_Approx":600,"Prestige_Level":6,"Special_Ability":"Identity Erasure","Lore_Notes":"Mythical house said to consist entirely of people who erased their own histories. May not officially exist at all."}]