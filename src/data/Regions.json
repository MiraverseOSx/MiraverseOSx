[{"Region_ID":"REG001","Region_Name":"Ironspire","Biome_Type":"Industrial Militarized City","Climate":"Harsh/Smoky","Controlling_Faction_ID":"FAC001","Primary_House_ID":"HSE001","Population_Approx":380000,"Danger_Level":6,"Key_Resources":["Steel","Coal","Weapons","Military Rations"],"Fast_Travel_Hub":"Yes","Unlock_Method":"Default Start or Imperial Path","Subzones":["The Foundry","War District","Halvorn Citadel","Ironclaw Keep","The Armory Quarter"],"Ambient_Event_Pool":["Imperial Parade","Weapons Market","Draft Conscription","Military Drill","Ironveil March"],"Lore_Notes":"The largest military city in the Miraverse. Every building is a fortress. The sky is permanently obscured by forge-smoke. Built on the bones of a pre-Collapse metropolis."},{"Region_ID":"REG002","Region_Name":"Citadel","Biome_Type":"Political Capital City","Climate":"Temperate/Urban","Controlling_Faction_ID":"FAC002","Primary_House_ID":"HSE003","Population_Approx":520000,"Danger_Level":3,"Key_Resources":["Political Documents","Rare Books","Biotech","Luxury Goods"],"Fast_Travel_Hub":"Yes","Unlock_Method":"Default Start or Republic Path","Subzones":["The Council Chambers","Nox Tower","Voss Institute","Scholar's Row","The Diplomatic Quarter"],"Ambient_Event_Pool":["Council Session","Political Debate","Assassination Attempt","Festival of Reason","Citadel Summit"],"Lore_Notes":"The seat of the Verdant Republic. The most densely populated region. Every faction maintains a covert presence here. Beneath the polished streets lie tunnels connecting to every district."},{"Region_ID":"REG003","Region_Name":"Verdania","Biome_Type":"Lush Forest Academic Zone","Climate":"Warm/Humid","Controlling_Faction_ID":"FAC002","Primary_House_ID":"HSE002","Population_Approx":95000,"Danger_Level":4,"Key_Resources":["Ancient Texts","Rare Flora","Research Data","Medicinal Herbs"],"Fast_Travel_Hub":"Yes","Unlock_Method":"Reach Verdania via Republic questline","Subzones":["Verdant Archive","The Grove Academy","Solenne Estate","Canopy Villages","The Living Wall"],"Ambient_Event_Pool":["Research Discovery","Rare Herb Bloom","Lore Fragment Spawn","Root Covenant Pilgrimage","Storm of Whispers"],"Lore_Notes":"A vast forest where universities and research stations grow among ancient trees. The Verdant Archive holds more knowledge than any other library in the Miraverse."},{"Region_ID":"REG004","Region_Name":"Neon Sprawl","Biome_Type":"Cyberpunk Underground City","Climate":"Hot/Neon-Lit","Controlling_Faction_ID":"FAC003","Primary_House_ID":"HSE008","Population_Approx":640000,"Danger_Level":7,"Key_Resources":["Data","Black Market Goods","Contraband","Neural Chips"],"Fast_Travel_Hub":"Yes","Unlock_Method":"Default Start or Drifter Path","Subzones":["The Black Vault","Drifter HQ","Syndicate Row","The Neon Market","Undervault Access"],"Ambient_Event_Pool":["Blackout Event","Syndicate Heist","Street Race","Drifter Rally","Data Breach"],"Lore_Notes":"A sprawling underground city built in the ruins of a pre-Collapse megacity. Neon signs cover crumbling walls. The Syndicate controls every shadow. The Drifters hide in every gap."},{"Region_ID":"REG005","Region_Name":"Rootveil","Biome_Type":"Ancient Forest Spiritual Grove","Climate":"Misty/Eternal","Controlling_Faction_ID":"FAC004","Primary_House_ID":"HSE004","Population_Approx":28000,"Danger_Level":5,"Key_Resources":["Sacred Herbs","Void-touched Wood","Root Crystals","Nature Essence"],"Fast_Travel_Hub":"No","Unlock_Method":"Complete Root Covenant intro quest","Subzones":["The Great Root","Elder's Sanctum","Asha's Grove","Moonpool","The Whispering Path"],"Ambient_Event_Pool":["Root Festival","Nature Communion","Ancient Memory Replay","Rootveil Storm","Spirit Walk"],"Lore_Notes":"The oldest region in the Miraverse. The trees here predate the First Collapse. The Root Covenant believes the forest is sentient. Outsiders feel watched at all times."},{"Region_ID":"REG006","Region_Name":"Sandveil","Biome_Type":"Desert Nomad Territory","Climate":"Arid/Scorching","Controlling_Faction_ID":"FAC008","Primary_House_ID":"HSE006","Population_Approx":41000,"Danger_Level":6,"Key_Resources":["Rare Minerals","Desert Spices","Sand Glass","Ancient Ruins"],"Fast_Travel_Hub":"No","Unlock_Method":"Reach Sandveil via Merchant or Nomad path","Subzones":["Oasis Stronghold","The Dune Market","Dawnrider Camp","Buried Temple","The Glass Plains"],"Ambient_Event_Pool":["Desert Storm","Dawnrider Race","Ancient Ruin Discovery","Sandveil Bandit Raid","Mirage Event"],"Lore_Notes":"A vast desert hiding ancient ruins beneath its sands. The Dawnrider clan knows every safe path. Outsiders who wander without a guide rarely return."},{"Region_ID":"REG007","Region_Name":"Port Mira","Biome_Type":"Coastal Trade Hub","Climate":"Tropical/Breezy","Controlling_Faction_ID":"FAC008","Primary_House_ID":"HSE007","Population_Approx":210000,"Danger_Level":3,"Key_Resources":["Trade Goods","Ship Parts","Seafood","Luxury Imports"],"Fast_Travel_Hub":"Yes","Unlock_Method":"Reach Port Mira via Merchant path","Subzones":["Crimsongate Harbor","The Exchange","Prism Tower","The Drowned Quay","Merchant Row"],"Ambient_Event_Pool":["Great Trade Fair","Ship Auction","Harbor Storm","Smuggler's Run","Merchant Guild Summit"],"Lore_Notes":"The wealthiest city in the Miraverse by trade volume. Every ship passing through the Miraverse Sea pays a toll to the Merchant Guilds. Rumors say the harbor hides a sunken pre-Collapse city."},{"Region_ID":"REG008","Region_Name":"Void Rift","Biome_Type":"Dimensional Fracture Zone","Climate":"Unstable/Crackling","Controlling_Faction_ID":"FAC007","Primary_House_ID":"HSE009","Population_Approx":1200,"Danger_Level":10,"Key_Resources":["Void Crystals","Rift Energy","Dimensional Shards","Unknown Materials"],"Fast_Travel_Hub":"No","Unlock_Method":"Unlock Void Walker faction + Danger Level 8 clearance","Subzones":["The Veil Sanctum","Rift Core","Dimensional Bridge","The Shatter","Sable's Anchor"],"Ambient_Event_Pool":["Void Storm","Rift Collapse","Dimensional Echo","Void Walker Ritual","Reality Fracture"],"Lore_Notes":"A region where the boundary between the digital and physical world has broken. Reality bends and loops here. Time does not move in a straight line. Only Void Walkers survive long-term exposure."},{"Region_ID":"REG009","Region_Name":"The Shattered Peaks","Biome_Type":"War-torn Mountain Range","Climate":"Cold/Unstable","Controlling_Faction_ID":"FAC012","Primary_House_ID":"HSE012","Population_Approx":18000,"Danger_Level":9,"Key_Resources":["Rare Ores","Military Salvage","Ashenveil Stone","Explosive Crystals"],"Fast_Travel_Hub":"No","Unlock_Method":"Complete Shattered Peaks War questline","Subzones":["Ashenveil Crater","The Broken Fortress","Ironclaw Outpost","The Frozen Pass","War Memorial"],"Ambient_Event_Pool":["Avalanche","Unexploded Ordnance","Ashenveil Ambush","Imperial Patrol","Peaks Blizzard"],"Lore_Notes":"A mountain range shattered by the war between the Ironveil Empire and the Ashenveil Clan. Unexploded ordnance litters every valley. The ruins of great fortresses jut from the ice."},{"Region_ID":"REG010","Region_Name":"The Undervault","Biome_Type":"Underground Ruins","Climate":"Dark/Damp","Controlling_Faction_ID":"FAC009","Primary_House_ID":"HSE011","Population_Approx":3400,"Danger_Level":8,"Key_Resources":["Pre-Collapse Tech","Ancient Artifacts","House Mireth Relics","Buried Data"],"Fast_Travel_Hub":"No","Unlock_Method":"Discover Undervault entrance in Neon Sprawl basement","Subzones":["Mireth Ruins","The Architect's Workshop","Hex's Server Lair","The Collapsed Archive","The Deep Gate"],"Ambient_Event_Pool":["Structural Collapse","Ancient Guardian Awakening","Relic Discovery","Data Ghost Encounter","Undervault Quake"],"Lore_Notes":"The ruins of the original pre-Collapse world buried beneath the Miraverse. House Mireth's destroyed seat of power lies here. The Architects study it daily. No one has mapped the full depth."},{"Region_ID":"REG011","Region_Name":"The Mirror Coast","Biome_Type":"Coastal Cliffs & Sea Caves","Climate":"Cool/Windy","Controlling_Faction_ID":"FAC008","Primary_House_ID":"HSE007","Population_Approx":32000,"Danger_Level":5,"Key_Resources":["Pearl","Sea Crystals","Shipwreck Salvage","Rare Fish"],"Fast_Travel_Hub":"No","Unlock_Method":"Reach via Port Mira sea route","Subzones":["Crystal Caves","The Wrecker's Shore","Mirror Bay","Lighthouse Ruins","Smuggler's Cove"],"Ambient_Event_Pool":["Shipwreck Discovery","Pirate Raid","Crystal Cave Bloom","Lighthouse Ghost","Tidal Storm"],"Lore_Notes":"A rugged coastline south of Port Mira known for its reflective sea caves. Smugglers use the coves to bypass the Guild's harbor tolls. Ancient shipwrecks litter the seafloor."},{"Region_ID":"REG012","Region_Name":"The Digital Sprawl","Biome_Type":"Pure Digital Zone","Climate":"Shifting/Electric","Controlling_Faction_ID":null,"Primary_House_ID":null,"Population_Approx":0,"Danger_Level":7,"Key_Resources":["Data Fragments","Algorithm Cores","Digital Crystals","Source Code Shards"],"Fast_Travel_Hub":"No","Unlock_Method":"Unlock via Netrunner questline or Neural Interface upgrade","Subzones":["The Data Sea","ORACLE-9's Domain","Corrupted Server Zone","The Firewall","Digital Void"],"Ambient_Event_Pool":["Data Storm","Algorithm Collapse","Ghost Program Encounter","ORACLE-9 Communication","Digital Fracture"],"Lore_Notes":"A purely digital region existing inside the Miraverse's network layer. Physical bodies cannot enter without neural interface augmentation. ORACLE-9 is rumored to exist somewhere in its depths."},{"Region_ID":"REG013","Region_Name":"The Amber Wastes","Biome_Type":"Post-Apocalyptic Wasteland","Climate":"Toxic/Hazy","Controlling_Faction_ID":"FAC001","Primary_House_ID":null,"Population_Approx":5600,"Danger_Level":8,"Key_Resources":["Toxic Materials","Scrap Metal","Survival Supplies","Mutated Creatures"],"Fast_Travel_Hub":"No","Unlock_Method":"Complete Imperial wasteland expedition quest","Subzones":["The Toxic Flats","Scavenger's Camp","Imperial Outpost","The Amber Lake","Waste Creature Nest"],"Ambient_Event_Pool":["Toxic Storm","Scavenger War","Imperial Patrol","Mutant Creature Attack","Amber Geyser"],"Lore_Notes":"A region destroyed by experimental weapons testing during the Halvorn Conquest. The air itself is toxic. Only scavengers and Imperial punishment squads are sent here."},{"Region_ID":"REG014","Region_Name":"The Floating Isles","Biome_Type":"Sky Islands","Climate":"Temperate/Breezy","Controlling_Faction_ID":"FAC002","Primary_House_ID":"HSE002","Population_Approx":14000,"Danger_Level":6,"Key_Resources":["Wind Energy","Cloud Minerals","Sky Crystals","Rare Birds"],"Fast_Travel_Hub":"No","Unlock_Method":"Unlock via Arcanist questline or Skybreaker Cannon discovery","Subzones":["Solenne Sky Station","The Crystal Archipelago","Wind Farms","The Sky Market","The Vantage"],"Ambient_Event_Pool":["Sky Storm","Wind Pirate Raid","Crystal Bird Migration","Arcane Surge Zone","Floating Island Drift"],"Lore_Notes":"A cluster of islands suspended in the sky by ancient pre-Collapse technology that no one fully understands. The Verdant Republic uses them for high-altitude research. Wind pirates patrol the air lanes."},{"Region_ID":"REG015","Region_Name":"The Biolabs District","Biome_Type":"Hidden Underground Research Zone","Climate":"Sterile/Artificial","Controlling_Faction_ID":"FAC005","Primary_House_ID":"HSE005","Population_Approx":8900,"Danger_Level":7,"Key_Resources":["Bio-specimens","Neural Chips","Experimental Drugs","Research Data"],"Fast_Travel_Hub":"No","Unlock_Method":"Complete Voss Collective questline chapter 2","Subzones":["Voss Deep Lab","The Specimen Vault","Neural Interface Chamber","Containment Zone B","The Ethics-Free Ward"],"Ambient_Event_Pool":["Lab Escape","Experiment Gone Wrong","Rogue Augment","Security Lockdown","Bio-Breach"],"Lore_Notes":"A hidden district beneath the Citadel that the Voss Collective uses for their most controversial research. The Republic officially denies its existence. Accidents here have been covered up repeatedly."}]