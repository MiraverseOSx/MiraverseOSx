{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MiraverseWorldSchema",
  "description": "Unified world contract schema defining entities, lore, items, and protocols for MIRAVERSE OSX.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { 
            "type": "string", 
            "enum": ["agent", "item", "location", "faction", "system"] 
          },
          "lore_summary": { "type": "string" },
          "attributes": { "type": "object" }
        },
        "required": ["id", "name", "type"]
      }
    },
    "protocols": {
      "type": "object",
      "properties": {
        "agent_api_version": { "type": "string", "default": "v1" },
        "frontend_sync_interval_ms": { "type": "integer", "default": 1000 },
        "db_provider": { "type": "string", "default": "sqlite3" }
      }
    }
  },
  "required": ["version", "entities", "protocols"]
}
